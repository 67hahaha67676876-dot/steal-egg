-- ===================== RENDER LOOP =====================
RunService.RenderStepped:Connect(function()
    local ch = LocalPlayer.Character; if not ch then return end
    local root = ch:FindFirstChild("HumanoidRootPart")
    local hum = ch:FindFirstChildWhichIsA("Humanoid")
    if not root or not hum then return end

    if S.Speed then hum.WalkSpeed = S.SpeedVal end
    if S.Noclip then
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    if S.Fly then
        if not flyOn then goFly() end
        if flyBV and flyBG then
            local sp = S.FlySpeed
            local d = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then d = d + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then d = d - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then d = d - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then d = d + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then d = d + Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then d = d - Vector3.new(0,1,0) end
            if d.Magnitude > 0 then d = d.Unit end
            flyBV.Velocity = d * sp
            flyBG.CFrame = Camera.CFrame
        end
    else
        if flyOn then noFly() end
    end
end)

-- ===================== HEARTBEAT LOOP =====================
local lastCol, lastHatch, lastSell = 0, 0, 0

RunService.Heartbeat:Connect(function()
    local ch = LocalPlayer.Character; if not ch then return end
    local root = ch:FindFirstChild("HumanoidRootPart"); if not root then return end
    local now = tick()

    -- Auto Collect (ProximityPrompt yakininda)
    if S.AutoCollect and now - lastCol > 0.3 then
        lastCol = now
        pcall(function()
            if fireproximityprompt then
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") and obj.Enabled then
                        local par = obj.Parent
                        if par then
                            local pos
                            if par:IsA("BasePart") then pos = par.Position
                            else
                                local bp = par:FindFirstChildWhichIsA("BasePart")
                                if bp then pos = bp.Position end
                            end
                            if pos and (pos - root.Position).Magnitude <= (obj.MaxActivationDistance or 10) + 2 then
                                fireproximityprompt(obj)
                            end
                        end
                    end
                end
            end
        end)
    end

    -- Auto Hatch
    if S.AutoHatch and now - lastHatch > 1.5 then
        lastHatch = now
        pcall(function()
            if R.AskHatch then R.AskHatch:InvokeServer() end
        end)
        pcall(function()
            if R.AskFinishHatch then R.AskFinishHatch:InvokeServer() end
        end)
    end

    -- Auto Sell
    if S.AutoSell and now - lastSell > 3 then
        lastSell = now
        pcall(function()
            if R.SellEveryPet then R.SellEveryPet:FireServer() end
        end)
    end

    -- Player ESP
    if S.PlayerESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local key = "p_" .. plr.UserId
                if not espHL[key] then
                    pcall(function()
                        local hl = Instance.new("Highlight")
                        hl.FillColor = Color3.fromRGB(255, 80, 80)
                        hl.FillTransparency = 0.6
                        hl.OutlineColor = Color3.fromRGB(255, 100, 100)
                        hl.OutlineTransparency = 0.1
                        hl.Adornee = plr.Character
                        hl.Parent = plr.Character
                        espHL[key] = hl
                    end)
                end
            end
        end
    end

    -- Egg ESP
    if S.EggESP then
        pcall(function()
            for _, obj in ipairs(workspace:GetDescendants()) do
                if (obj:IsA("Model") or obj:IsA("BasePart")) then
                    local n = obj.Name:lower()
                    if n:find("egg") or n:find("nest") then
                        local key = "e_" .. tostring(obj)
                        if not espHL[key] then
                            local hl = Instance.new("Highlight")
                            hl.FillColor = Color3.fromRGB(255, 220, 50)
                            hl.FillTransparency = 0.5
                            hl.OutlineColor = Color3.fromRGB(255, 200, 30)
                            hl.OutlineTransparency = 0
                            hl.Adornee = obj
                            hl.Parent = obj
                            espHL[key] = hl
                        end
                    end
                end
            end
        end)
    end

    if not S.PlayerESP and not S.EggESP then
        if next(espHL) then clearESP() end
    end
end)

