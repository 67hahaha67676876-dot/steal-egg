-- ===================== GAME SCANNER (find objects) =====================
local gameData = {
    eggLocations = {},
    areas = {},
    remotes = {},
    prompts = {},
    chests = {},
}

local function scanGame()
    gameData.eggLocations = {}
    gameData.areas = {}
    gameData.prompts = {}
    gameData.chests = {}

    -- Egg ve Nest arama
    local function searchForEggs(parent, depth)
        if depth > 6 then return end
        for _, child in ipairs(parent:GetChildren()) do
            local n = child.Name:lower()
            if (n:find("egg") or n:find("nest") or n:find("steal")) and child:IsA("BasePart") then
                table.insert(gameData.eggLocations, child)
            end
            if (n:find("egg") or n:find("nest") or n:find("steal")) and child:IsA("Model") then
                table.insert(gameData.eggLocations, child)
            end
            -- ProximityPrompt bul
            local prompt = child:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt then
                table.insert(gameData.prompts, {Object = child, Prompt = prompt})
            end
            -- Chest/kutu ara
            if (n:find("chest") or n:find("reward") or n:find("gift") or n:find("crate") or n:find("loot")) then
                table.insert(gameData.chests, child)
            end
            -- Area/Biome ara
            if (n:find("area") or n:find("biome") or n:find("zone") or n:find("world") or n:find("island") or n:find("dimension") or n:find("realm")) then
                if child:IsA("Model") or child:IsA("Folder") or child:IsA("BasePart") then
                    table.insert(gameData.areas, child)
                end
            end
            pcall(function() searchForEggs(child, depth + 1) end)
        end
    end

    pcall(function() searchForEggs(workspace, 0) end)

    -- Remote event/function tara
    gameData.remotes = {}
    local function scanRemotes(parent)
        for _, child in ipairs(parent:GetChildren()) do
            if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") then
                local n = child.Name:lower()
                if n:find("egg") or n:find("hatch") or n:find("steal") or n:find("collect")
                    or n:find("buy") or n:find("open") or n:find("claim") or n:find("pet")
                    or n:find("sell") or n:find("delete") or n:find("equip") then
                    table.insert(gameData.remotes, {Name = child.Name, Type = child.ClassName, Object = child})
                end
            end
            pcall(function() scanRemotes(child) end)
        end
    end
    pcall(function() scanRemotes(ReplicatedStorage) end)

    return gameData
end

