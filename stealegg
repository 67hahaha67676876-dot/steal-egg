local function switchTab(name)
    if not tabPages[name] then return end
    -- deactivate old
    local oldBtn = tabButtons[activeTab]
    if oldBtn then
        tween(oldBtn.Button, 0.2, {BackgroundTransparency = 1})
        oldBtn.NameLabel.TextColor3 = Theme.SubText
        oldBtn.Indicator.Visible = false
        tween(oldBtn.Indicator, 0.15, {Size = UDim2.new(0, 3, 0, 0)})
    end
    if tabPages[activeTab] then tabPages[activeTab].Visible = false end

    activeTab = name
    local newBtn = tabButtons[name]
    tween(newBtn.Button, 0.2, {BackgroundTransparency = 0.6})
    newBtn.NameLabel.TextColor3 = Theme.Text
    newBtn.Indicator.Visible = true
    tween(newBtn.Indicator, 0.25, {Size = UDim2.new(0, 3, 0, 20)})
    tabPages[name].Visible = true
end

for name, data in pairs(tabButtons) do
    data.Button.MouseButton1Click:Connect(function()
        switchTab(name)
    end)
end

