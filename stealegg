UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    -- Toggle GUI: RightShift
    if input.KeyCode == Enum.KeyCode.RightShift then
        MainFrame.Visible = not MainFrame.Visible
    end

    -- Toggle Fly: F
    if input.KeyCode == Enum.KeyCode.F then
        Settings.FlyEnabled = not Settings.FlyEnabled
        showToast(Settings.FlyEnabled and "Fly: ON" or "Fly: OFF", Settings.FlyEnabled and Theme.Success or Theme.Error)
    end

    -- Toggle Speed: X
    if input.KeyCode == Enum.KeyCode.X then
        Settings.SpeedEnabled = not Settings.SpeedEnabled
        showToast(Settings.SpeedEnabled and "Speed: ON" or "Speed: OFF", Settings.SpeedEnabled and Theme.Success or Theme.Error)
    end

    -- Toggle Noclip: Z
    if input.KeyCode == Enum.KeyCode.Z then
        Settings.Noclip = not Settings.Noclip
        showToast(Settings.Noclip and "Noclip: ON" or "Noclip: OFF", Settings.Noclip and Theme.Success or Theme.Error)
    end
end)

