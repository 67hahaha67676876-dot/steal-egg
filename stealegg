local function mkToggle(parent, text, def, cb, ord)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 32)
    f.BackgroundColor3 = C.Cd
    f.BorderSizePixel = 0
    f.LayoutOrder = ord or 0
    f.Parent = parent
    pcall(function() Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6) end)

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -60, 1, 0)
    l.Position = UDim2.new(0, 10, 0, 0)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = C.Tx
    l.TextSize = 11
    l.Font = Enum.Font.GothamMed
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = f

    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(0, 36, 0, 18)
    bg.Position = UDim2.new(1, -46, 0.5, -9)
    bg.BackgroundColor3 = def and C.Pr or C.Dis
    bg.BorderSizePixel = 0
    bg.Parent = f
    pcall(function() Instance.new("UICorner", bg).CornerRadius = UDim.new(1, 0) end)

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 12, 0, 12)
    dot.Position = def and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
    dot.BackgroundColor3 = Color3.new(1, 1, 1)
    dot.BorderSizePixel = 0
    dot.Parent = bg
    pcall(function() Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0) end)

    local state = def
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 1, 0)
    b.BackgroundTransparency = 1
    b.Text = ""
    b.Parent = f

    b.MouseButton1Click:Connect(function()
        state = not state
        tw(bg, 0.2, {BackgroundColor3 = state and C.Pr or C.Dis})
        tw(dot, 0.2, {Position = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)})
        if cb then cb(state) end
    end)
    return f
end

local function mkSlider(parent, text, mn, mx, def, cb, ord)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 44)
    f.BackgroundColor3 = C.Cd
    f.BorderSizePixel = 0
    f.LayoutOrder = ord or 0
    f.Parent = parent
    pcall(function() Instance.new("UICorner", f).CornerRadius = UDim.new(0, 6) end)

    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -50, 0, 18)
    l.Position = UDim2.new(0, 10, 0, 2)
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = C.Tx
    l.TextSize = 11
    l.Font = Enum.Font.GothamMed
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = f

    local vl = Instance.new("TextLabel")
    vl.Size = UDim2.new(0, 40, 0, 18)
    vl.Position = UDim2.new(1, -48, 0, 2)
    vl.BackgroundTransparency = 1
    vl.Text = tostring(def)
    vl.TextColor3 = C.Pr
    vl.TextSize = 12
    vl.Font = Enum.Font.GothamBold
    vl.TextXAlignment = Enum.TextXAlignment.Right
    vl.Parent = f

    local sbg = Instance.new("Frame")
    sbg.Size = UDim2.new(1, -20, 0, 5)
    sbg.Position = UDim2.new(0, 10, 0, 28)
    sbg.BackgroundColor3 = C.Dis
    sbg.BorderSizePixel = 0
    sbg.Parent = f
    pcall(function() Instance.new("UICorner", sbg).CornerRadius = UDim.new(1, 0) end)

    local pct = (def - mn) / (mx - mn)
    local sf = Instance.new("Frame")
    sf.Size = UDim2.new(pct, 0, 1, 0)
    sf.BackgroundColor3 = C.Pr
    sf.BorderSizePixel = 0
    sf.Parent = sbg
    pcall(function() Instance.new("UICorner", sf).CornerRadius = UDim.new(1, 0) end)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 12, 0, 12)
    knob.Position = UDim2.new(pct, -6, 0.5, -6)
    knob.BackgroundColor3 = Color3.new(1, 1, 1)
    knob.BorderSizePixel = 0
    knob.Parent = sbg
    pcall(function() Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0) end)

    local sb = Instance.new("TextButton")
    sb.Size = UDim2.new(1, 6, 0, 18)
    sb.Position = UDim2.new(0, -3, 0, -6)
    sb.BackgroundTransparency = 1
    sb.Text = ""
    sb.Parent = sbg

    local sliding = false
    local function upd(input)
        local rel = math.clamp((input.Position.X - sbg.AbsolutePosition.X) / sbg.AbsoluteSize.X, 0, 1)
        local val = math.floor(mn + (mx - mn) * rel)
        vl.Text = tostring(val)
        sf.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, -6, 0.5, -6)
        if cb then cb(val) end
    end
    sb.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = true; upd(i) end end)
    sb.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end end)
    UserInputService.InputChanged:Connect(function(i) if sliding and i.UserInputType == Enum.UserInputType.MouseMovement then upd(i) end end)
    return f
end

local function mkButton(parent, text, cb, ord, color)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, 0, 0, 30)
    b.BackgroundColor3 = color or C.Bt
    b.BorderSizePixel = 0
    b.Text = text
    b.TextColor3 = C.Tx
    b.TextSize = 11
    b.Font = Enum.Font.GothamMed
    b.AutoButtonColor = false
    b.LayoutOrder = ord or 0
    b.Parent = parent
    pcall(function() Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6) end)
    b.MouseEnter:Connect(function() tw(b, 0.1, {BackgroundColor3 = C.Bh}) end)
    b.MouseLeave:Connect(function() tw(b, 0.1, {BackgroundColor3 = color or C.Bt}) end)
    b.MouseButton1Click:Connect(function() if cb then cb() end end)
    return b
end

