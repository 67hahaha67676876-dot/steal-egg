-- FLY
local flyBV, flyBG, flyOn = nil, nil, false
local function goFly()
    local ch = LocalPlayer.Character; if not ch then return end
    local r = ch:FindFirstChild("HumanoidRootPart")
    local h = ch:FindFirstChildWhichIsA("Humanoid")
    if not r or not h then return end
    flyOn = true; h.PlatformStand = true
    flyBV = Instance.new("BodyVelocity"); flyBV.MaxForce = Vector3.new(9e9,9e9,9e9); flyBV.Velocity = Vector3.zero; flyBV.Parent = r
    flyBG = Instance.new("BodyGyro"); flyBG.MaxTorque = Vector3.new(9e9,9e9,9e9); flyBG.D = 200; flyBG.P = 9000; flyBG.Parent = r
end
local function noFly()
    flyOn = false
    pcall(function() LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid").PlatformStand = false end)
    if flyBV then pcall(function() flyBV:Destroy() end); flyBV = nil end
    if flyBG then pcall(function() flyBG:Destroy() end); flyBG = nil end
end

-- ESP
local espHL = {}
local function clearESP()
