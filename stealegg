local function getRemote(name)
    if not Networking then return nil end
    local r = nil
    pcall(function()
        r = Networking:FindFirstChild(name)
    end)
    if not r then
        -- bazen alt klasorlerde olabilir
        pcall(function()
            for _, child in ipairs(Networking:GetDescendants()) do
                if child.Name == name then
                    r = child
                    break
                end
            end
        end)
    end
    return r
end

