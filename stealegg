-- AUTO STEAL & COLLECT LOOP (Heartbeat)
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local now = tick()

    -- AUTO STEAL (ProximityPrompt)
    if Settings.AutoSteal and now - lastStealTime > Settings.AutoStealDelay then
        lastStealTime = now
        for _, data in ipairs(gameData.prompts) do
            pcall(function()
                local prompt = data.Prompt
                local obj = data.Object
                if prompt and prompt.Parent then
                    local pos
                    if obj:IsA("Model") then
                        local p = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                        if p then pos = p.Position end
                    elseif obj:IsA("BasePart") then
                        pos = obj.Position
                    end
                    if pos and (pos - root.Position).Magnitude <= prompt.MaxActivationDistance + 5 then
                        fireproximityprompt(prompt)
                    end
                end
            end)
        end
    end

    -- AUTO TELEPORT TO EGGS
    if Settings.AutoTeleportEgg and now - lastStealTime > 1 then
        for _, egg in ipairs(gameData.eggLocations) do
            pcall(function()
                local pos
                if egg:IsA("Model") then
                    local p = egg.PrimaryPart or egg:FindFirstChildWhichIsA("BasePart")
                    if p then pos = p.Position end
                elseif egg:IsA("BasePart") then
                    pos = egg.Position
                end
                if pos then
                    root.CFrame = CFrame.new(pos + Vector3.new(0, 2, 0))
                    task.wait(Settings.AutoStealDelay + 0.3)
                end
            end)
        end
    end

    -- AUTO HATCH (remote arama)
    if Settings.AutoHatch and now - lastHatchTime > Settings.AutoHatchDelay then
        lastHatchTime = now
        for _, r in ipairs(gameData.remotes) do
            pcall(function()
                local n = r.Name:lower()
                if n:find("hatch") or n:find("open") then
                    if r.Type == "RemoteEvent" then
                        r.Object:FireServer()
                    elseif r.Type == "RemoteFunction" then
                        r.Object:InvokeServer()
                    end
                end
            end)
        end
    end

    -- AUTO COLLECT
    if Settings.AutoCollect then
        for _, obj in ipairs(workspace:GetDescendants()) do
            pcall(function()
                if obj:IsA("BasePart") and obj.Name:lower():find("collect") then
                    if (obj.Position - root.Position).Magnitude < 50 then
                        firetouchinterest(root, obj, 0)
                        task.defer(function()
                            firetouchinterest(root, obj, 1)
                        end)
                    end
                end
            end)
        end
    end

    -- AUTO CHEST
    if Settings.AutoChest then
        for _, chest in ipairs(gameData.chests) do
            pcall(function()
                if chest and chest.Parent then
                    local prompt = chest:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then
                        local pos
                        if chest:IsA("Model") then
                            local p = chest.PrimaryPart or chest:FindFirstChildWhichIsA("BasePart")
                            if p then pos = p.Position end
                        elseif chest:IsA("BasePart") then
                            pos = chest.Position
                        end
                        if pos and (pos - root.Position).Magnitude <= prompt.MaxActivationDistance + 5 then
                            fireproximityprompt(prompt)
                        end
                    end
                end
            end)
        end
    end

    -- ESP UPDATE
    if Settings.EggESP then
        for _, egg in ipairs(gameData.eggLocations) do
            pcall(function()
                if egg and egg.Parent then
                    addHighlight(egg, Color3.fromRGB(255, 200, 50), egg.Name)
                end
            end)
        end
    end

    if Settings.ChestESP then
        for _, chest in ipairs(gameData.chests) do
            pcall(function()
                if chest and chest.Parent then
                    addHighlight(chest, Color3.fromRGB(100, 200, 255), chest.Name)
                end
            end)
        end
    end

    if Settings.PlayerESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                pcall(function()
                    addHighlight(plr.Character, Color3.fromRGB(255, 80, 80), plr.DisplayName)
                end)
            end
        end
    end

    -- ESP temizleme (kapaliysa)
    if not Settings.EggESP and not Settings.ChestESP and not Settings.PlayerESP then
        if next(espHighlights) then
            clearESP()
        end
    end
end)

