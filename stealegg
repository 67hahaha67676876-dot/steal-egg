-- ===================== MAIN LOOP =====================
local lastCollectTime = 0
local lastHatchTime = 0
local lastSellTime = 0

RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not root or not hum then return end

    -- SPEED
    if Settings.SpeedEnabled then
        hum.WalkSpeed = Settings.SpeedValue
    end

    -- NOCLIP
    if Settings.Noclip then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end

    -- FLY
    if Settings.FlyEnabled then
        if not flyActive then startFly() end
        if flyBV and flyBG then
            local sp = Settings.FlySpeed
            local dir = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then dir = dir - Vector3.new(0, 1, 0) end
            if dir.Magnitude > 0 then dir = dir.Unit end
            flyBV.Velocity = dir * sp
            flyBG.CFrame = Camera.CFrame
        end
    else
        if flyActive then stopFly() end
    end
end)

-- HEARTBEAT LOOP (egg collecting, hatching, selling, ESP)
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local now = tick()

    -- AUTO COLLECT EGGS (ProximityPrompt + remote)
    if Settings.AutoCollectEggs and now - lastCollectTime > 0.3 then
        lastCollectTime = now

        -- Yakinindaki ProximityPrompt'lari tetikle
        pcall(function()
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("ProximityPrompt") and obj.Enabled then
                    local parent = obj.Parent
                    if parent and parent:IsA("BasePart") then
                        local dist = (parent.Position - root.Position).Magnitude
                        if dist <= obj.MaxActivationDistance + 2 then
                            fireproximityprompt(obj)
                        end
                    elseif parent then
                        local part = parent:FindFirstChildWhichIsA("BasePart")
                        if part then
                            local dist = (part.Position - root.Position).Magnitude
                            if dist <= obj.MaxActivationDistance + 2 then
                                fireproximityprompt(obj)
                            end
                        end
                    end
                end
            end
        end)
    end

    -- AUTO HATCH
    if Settings.AutoHatch and now - lastHatchTime > 1 then
        lastHatchTime = now
        pcall(function()
            if Remotes.AskHatch then
                Remotes.AskHatch:InvokeServer()
            end
            if Remotes.AskFinishHatch then
                Remotes.AskFinishHatch:InvokeServer()
            end
        end)
    end

    -- AUTO SELL PETS
    if Settings.AutoSellPets and now - lastSellTime > 3 then
        lastSellTime = now
        pcall(function()
            if Remotes.SellEveryPet then
                Remotes.SellEveryPet:FireServer()
            end
        end)
    end

    -- PLAYER ESP
    if Settings.PlayerESP then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                pcall(function()
                    if not espCache[plr.UserId] then
                        local hl = Instance.new("Highlight")
                        hl.FillColor = Color3.fromRGB(255, 80, 80)
                        hl.FillTransparency = 0.6
                        hl.OutlineColor = Color3.fromRGB(255, 100, 100)
                        hl.OutlineTransparency = 0.1
                        hl.Adornee = plr.Character
                        hl.Parent = plr.Character
                        espCache[plr.UserId] = hl
                    end
                end)
            end
        end
    end

    -- EGG ESP
    if Settings.EggESP then
        pcall(function()
            for _, obj in ipairs(workspace:GetDescendants()) do
                local n = obj.Name:lower()
                if (n:find("egg") or n:find("nest")) and (obj:IsA("Model") or obj:IsA("BasePart")) then
                    local key = "egg_" .. obj:GetFullName()
                    if not espCache[key] then
                        local hl = Instance.new("Highlight")
                        hl.FillColor = Color3.fromRGB(255, 220, 50)
                        hl.FillTransparency = 0.5
                        hl.OutlineColor = Color3.fromRGB(255, 200, 30)
                        hl.OutlineTransparency = 0
                        hl.Adornee = obj
                        hl.Parent = obj
                        espCache[key] = hl
                    end
                end
            end
        end)
    end

    -- ESP temizleme
    if not Settings.PlayerESP and not Settings.EggESP then
        if next(espCache) then clearESP() end
    end
end)

