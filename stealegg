-- ===================== ANTI-CHEAT BYPASS =====================
local bypassOK = false
pcall(function()
    if hookmetamethod and newcclosure then
        local oldNc
        oldNc = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" then
                local n = ""
                pcall(function() n = self.Name end)
                if n:find("Observability") or n:find("Telemetry") then
                    return
                end
            end
            return oldNc(self, ...)
        end))
        bypassOK = true
    end
end)
print("[EGG HUB v3] Bypass: " .. tostring(bypassOK))

